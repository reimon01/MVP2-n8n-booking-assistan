# Puerto del microservicio (default 3000)
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://vida:vida@localhost:5432/vida_v2

# Tenant: UUID del salón en la base de datos.
# Si se deja vacío el servidor lo resuelve por whatsapp_phone del webhook.
TENANT_ID=

# OpenAI / LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=changeme
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
